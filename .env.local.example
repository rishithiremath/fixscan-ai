# Copy this file to .env.local and fill in YOUR OWN values.
# Never commit .env.local to GitHub. Never paste real keys in chat.
# Demo Mode works without any of these values set.

# Supabase - from supabase.com > your project > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini - from Google AI Studio (aistudio.google.com) > Get API Key
# SERVER ONLY. This key must never appear in browser code or in GitHub.
GEMINI_API_KEY=

# Model is hardcoded to gemini-2.5-flash in app/api/analyse/route.ts.
# Do NOT set GEMINI_MODEL — it is not read by the code.
